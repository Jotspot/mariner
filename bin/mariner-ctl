#!/usr/bin/env python3
"""Mariner control tool: the only privileged entry point.

The web portal (user `mariner`) may run exactly this program via sudo. Every
subcommand validates its input; secrets arrive as JSON on stdin (never on the
command line) and are never echoed back. Output is JSON on stdout; errors are
{"error": "..."} with exit status 1.

    mariner-ctl status
    mariner-ctl reconcile [--no-units]
    mariner-ctl vpn-get | vpn-set (stdin) | vpn-enable on|off | vpn-exits | vpn-probe [--force]
    mariner-ctl evpn-login (stdin {"code": ...}) | evpn-logout
    mariner-ctl portal-login-allow | check
    mariner-ctl wifi-scan | wifi-saved | wifi-connect | wifi-forget | wifi-band | wifi-lock   (stdin)
    mariner-ctl hotspot-get | hotspot-set (stdin) | devices
    mariner-ctl public-ip [--fresh]
    mariner-ctl logs (stdin {"source": ...}) | restart (stdin {"service": ...}) | reboot | poweroff
    mariner-ctl set-portal-password (stdin {"password": ...})

VPN providers (exactly one runs at a time):
  geph      geph5-client  -> SOCKS5 127.0.0.1:9909 -> tun2socks (vpn0)
  outline   sslocal       -> SOCKS5 127.0.0.1:9909 -> tun2socks (vpn0)
  expressvpn  the official app, sandboxed in network namespace "evpn";
            hotspot traffic is routed straight into it (veth evh, 10.200.0.2)
            and may only leave through ExpressVPN's tunnel.
"""
import base64
import fcntl
import hashlib
import json
import os
import re
import secrets
import socket
import subprocess
import sys
import time
from urllib.parse import parse_qs, unquote

ETC = "/etc/mariner"
RUN = "/run/mariner"
VPN_JSON = f"{ETC}/vpn.json"          # root 0600: VPN settings + credentials/keys
OLD_GEPH_JSON = f"{ETC}/geph.json"    # pre-Outline settings file, migrated on first use
GEPH_YAML = f"{ETC}/geph.yaml"        # root 0600: generated geph5-client config
OUTLINE_CONF = f"{ETC}/outline.json"  # root 0600: generated sslocal config
PORTAL_JSON = f"{ETC}/portal.json"    # root:mariner 0640: password hash + cookie key
PORTAL_STATE = f"{RUN}/portal.json"   # written by mariner-check
VPN_STATE = f"{RUN}/vpn.json"         # written by reconcile
EXIT_PROBE = f"{RUN}/vpn-exit.json"   # where VPN traffic comes out (geo lookup through the tunnel)
CONNECTED_SINCE = f"{RUN}/vpn-connected-since"
GEPH_ACCOUNT = f"{RUN}/geph-account.json"
LOGIN_WINDOW = f"{RUN}/portal-login-until"
PUBLIC_IP = f"{RUN}/public-ip.json"
EXITS_CACHE = "/var/lib/mariner/geph-exits.json"

HOTSPOT = "mariner-hotspot"
UPLINK_IF, HOTSPOT_IF, TUN_IF = "wlan0", "uap0", "vpn0"
HOTSPOT_NET = "10.42.0.0/24"
TABLE, RULE_PRIO = "100", "1000"
CONTROL = ("127.0.0.1", 12222)
SOCKS = "127.0.0.1:9909"
LOGIN_WINDOW_SECS = 600
# Tests only: extra interfaces treated exactly like the hotspot (e.g. a veth
# to a network namespace that plays a phone). Lives in /run, so a reboot
# clears it.
TEST_IFS_FILE = f"{RUN}/test-hotspot-ifs"

PROVIDERS = {
    "expressvpn": {"name": "ExpressVPN", "service": "expressvpn-service.service",
                   "target": "mariner-vpn-expressvpn.target"},
    "geph": {"name": "Geph", "service": "geph5.service", "target": "mariner-vpn-geph.target"},
    "outline": {"name": "Outline", "service": "outline-ss.service", "target": "mariner-vpn-outline.target"},
}
VPN_DEFAULTS = {"enabled": False, "provider": "geph", "killswitch": True,
                "geph": {"exit": "auto", "credentials": None}, "outline": None,
                "expressvpn": {"signed_in": False, "region": "smart", "protocol": "wireguard"}}

# ExpressVPN sandbox (bin/mariner-evpn-netns)
EVPN_CTL = "/opt/expressvpn/bin/expressvpnctl"
EVPN_NS, EVPN_HOST_IF, EVPN_NS_IP = "evpn", "evh", "10.200.0.2"
EVPN_REGIONS = "/var/lib/mariner/evpn-regions.json"
# Lightway is offered but crawls on the Pi 4 (one core at 100% for ~1 Mbit/s).
EVPN_PROTOCOLS = ("wireguard", "openvpnudp", "openvpntcp", "lightwayudp", "lightwaytcp", "auto")

SS_METHODS = {"chacha20-ietf-poly1305", "xchacha20-ietf-poly1305", "aes-128-gcm", "aes-256-gcm",
              "2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm", "2022-blake3-chacha20-poly1305"}

# Broker list and keys from the official Geph app's default config
# (geph-official/geph5, binaries/geph5-app/default-config.yaml).
BROKER_YAML = """broker:
