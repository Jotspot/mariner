#!/usr/bin/env python3
"""Mariner control tool: the only privileged entry point.

The web portal (user `mariner`) may run exactly this program via sudo. Every
subcommand validates its input; secrets arrive as JSON on stdin (never on the
command line) and are never echoed back. Output is JSON on stdout; errors are
{"error": "..."} with exit status 1.

    mariner-ctl status
    mariner-ctl reconcile [--no-units]
    mariner-ctl vpn-get | vpn-set (stdin) | vpn-enable on|off | vpn-exits | vpn-probe [--force]
    mariner-ctl evpn-login (stdin {"code": ...}) | evpn-logout
    mariner-ctl portal-login-allow | check
    mariner-ctl wifi-scan | wifi-saved | wifi-connect | wifi-forget | wifi-band | wifi-lock   (stdin)
    mariner-ctl hotspot-get | hotspot-set (stdin) | devices
    mariner-ctl public-ip [--fresh]
    mariner-ctl logs (stdin {"source": ...}) | restart (stdin {"service": ...}) | reboot | poweroff
    mariner-ctl set-portal-password (stdin {"password": ...})

VPN providers (exactly one runs at a time):
  geph      geph5-client  -> SOCKS5 127.0.0.1:9909 -> tun2socks (vpn0)
  outline   sslocal       -> SOCKS5 127.0.0.1:9909 -> tun2socks (vpn0)
  expressvpn  the official app, sandboxed in network namespace "evpn";
            hotspot traffic is routed straight into it (veth evh, 10.200.0.2)
            and may only leave through ExpressVPN's tunnel.
"""
import base64
import fcntl
import hashlib
import ipaddress
import json
import os
import re
import secrets
import socket
import subprocess
import sys
import time
from urllib.parse import parse_qs, unquote

