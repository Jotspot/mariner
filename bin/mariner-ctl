EVPN_NS, EVPN_HOST_IF, EVPN_NS_IP = "evpn", "evh", "10.200.0.2"
EVPN_REGIONS = "/var/lib/mariner/evpn-regions.json"
# Lightway is offered but crawls on the Pi 4 (one core at 100% for ~1 Mbit/s).
EVPN_PROTOCOLS = ("wireguard", "openvpnudp", "openvpntcp", "lightwayudp", "lightwaytcp", "auto")

SS_METHODS = {"chacha20-ietf-poly1305", "xchacha20-ietf-poly1305", "aes-128-gcm", "aes-256-gcm",
              "2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm", "2022-blake3-chacha20-poly1305"}

