#!/bin/bash
# ExpressVPN sandbox: network namespace "evpn", joined to the host by the veth
# pair evh (host, 10.200.0.1) <-> evn (namespace, 10.200.0.2).
#
# The official ExpressVPN daemon runs only in here (systemd drop-in
# expressvpn-service.service.d/mariner.conf), so its routes, DNS and firewall
# never touch the host. Hotspot traffic is routed into the namespace and must
# leave it through ExpressVPN's tunnel; the guard table below drops anything
# else, so a disconnected VPN means blocked traffic, never a leak.
#
#   mariner-evpn-netns up | down
set -euo pipefail
NS=evpn HOST_IF=evh NS_IF=evn HOST_IP=10.200.0.1 NS_IP=10.200.0.2 HOTSPOT_NET=10.42.0.0/24

case "${1:-}" in
up)
    ip netns list | grep -qw "$NS" || ip netns add "$NS"
    if ! ip link show "$HOST_IF" >/dev/null 2>&1; then
        ip link add "$HOST_IF" type veth peer name "$NS_IF" netns "$NS"
    fi
    ip addr replace "$HOST_IP/30" dev "$HOST_IF"
    ip link set "$HOST_IF" up
    ip -n "$NS" link set lo up
    ip -n "$NS" addr replace "$NS_IP/30" dev "$NS_IF"
    ip -n "$NS" link set "$NS_IF" up
    ip -n "$NS" route replace default via "$HOST_IP"
    ip -n "$NS" route replace "$HOTSPOT_NET" via "$HOST_IP"
    ip netns exec "$NS" sysctl -qw net.ipv4.ip_forward=1 \
        net.ipv6.conf.all.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1
    mkdir -p "/etc/netns/$NS"
    [ -s "/etc/netns/$NS/resolv.conf" ] || echo "nameserver 1.1.1.1" > "/etc/netns/$NS/resolv.conf"
    ip netns exec "$NS" nft -f - <<'EOF'
table inet mariner_guard {}
delete table inet mariner_guard
table inet mariner_guard {
    chain forward {
        type filter hook forward priority filter - 20; policy accept;
        # Hotspot traffic may only leave through ExpressVPN's tunnel.
        iifname "evn" oifname != { "wgexpressvpn*", "tun*" } counter drop comment "no tunnel, no traffic"
    }
    chain output {
        type filter hook output priority filter - 20; policy accept;
        # Mariner's DNS forwarder (user mariner) may only use the tunnel, apart
        # from its answers back to the host end of the veth (10.200.0.1).
        meta skuid "mariner" ip daddr != 10.200.0.0/30 oifname != { "wgexpressvpn*", "tun*", "lo" } counter drop comment "dns via tunnel only"
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        iifname "evn" oifname { "wgexpressvpn*", "tun*" } masquerade
    }
}
EOF
    ;;
down)
    ip link del "$HOST_IF" 2>/dev/null || true
    ip netns del "$NS" 2>/dev/null || true
    ;;
*)
    echo "usage: $0 up|down" >&2
    exit 1
    ;;
esac
