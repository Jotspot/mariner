#!/bin/sh
# Called by tun2socks (--tun-post-up) once vpn0 exists: bring it up and make
# it the default route of the hotspot routing table (100). The address only
# exists so NM's masquerade rule has a source address to use.
ip addr replace 198.18.0.1/30 dev vpn0
ip link set vpn0 up
ip route replace default dev vpn0 metric 10 table 100
# Apply Mariner's routing and firewall for the new tunnel right away (with the
# kill switch off nothing else would route hotspot traffic into it until the
# next check). In the background: tun2socks waits for this script.
# Then confirm the VPN carries traffic (a few seconds, not the next minute's
# check), so the status shows "connected" as soon as it is.
setsid sh -c '/usr/local/lib/mariner/bin/mariner-ctl reconcile --no-units --wait
              /usr/local/lib/mariner/bin/mariner-ctl vpn-settle' >/dev/null 2>&1 &
