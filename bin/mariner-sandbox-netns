#!/bin/bash
# Sandboxes for VPN apps that want to control a whole machine (ExpressVPN,
# Cloudflare WARP): each gets its own network namespace, joined to the host by
# a veth pair. The app's daemon runs only in there (a systemd drop-in sets its
# NetworkNamespacePath), so its routes, DNS and firewall never touch the host.
# Hotspot traffic is routed into the namespace and must leave it through the
# app's tunnel; the guard table below drops anything else, so a disconnected
# VPN means blocked traffic, never a leak.
#
#   mariner-sandbox-netns evpn|warp up|down
#
#   evpn: ExpressVPN  evh 10.200.0.1 <-> evn 10.200.0.2  tunnel wgexpressvpn*/tun*
#   warp: WARP        wph 10.200.0.5 <-> wpn 10.200.0.6  tunnel CloudflareWARP
set -euo pipefail
HOTSPOT_NET=10.42.0.0/24
case "${1:-}" in
evpn) NS=evpn HOST_IF=evh NS_IF=evn HOST_IP=10.200.0.1 NS_IP=10.200.0.2 NET=10.200.0.0/30
      TUN='"wgexpressvpn*", "tun*"' ;;
warp) NS=warp HOST_IF=wph NS_IF=wpn HOST_IP=10.200.0.5 NS_IP=10.200.0.6 NET=10.200.0.4/30
      TUN='"CloudflareWARP"' ;;
*) echo "usage: $0 evpn|warp up|down" >&2; exit 1 ;;
esac
in_ns() { nsenter --net="/run/netns/$NS" "$@"; }  # not "ip netns exec"/"ip -n": no /sys remount (containers)

case "${2:-}" in
up)
    ip netns list | grep -qw "$NS" || ip netns add "$NS"
    if ! ip link show "$HOST_IF" >/dev/null 2>&1; then
        ip link add "$HOST_IF" type veth peer name "$NS_IF" netns "$NS"
    fi
    ip addr replace "$HOST_IP/30" dev "$HOST_IF"
    ip link set "$HOST_IF" up
    in_ns ip link set lo up
    in_ns ip addr replace "$NS_IP/30" dev "$NS_IF"
    in_ns ip link set "$NS_IF" up
    in_ns ip route replace default via "$HOST_IP"
    in_ns ip route replace "$HOTSPOT_NET" via "$HOST_IP"
    in_ns sysctl -qw net.ipv4.ip_forward=1 \
        net.ipv6.conf.all.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1
    mkdir -p "/etc/netns/$NS"
    [ -s "/etc/netns/$NS/resolv.conf" ] || echo "nameserver 1.1.1.1" > "/etc/netns/$NS/resolv.conf"
    in_ns nft -f - <<EOF
table inet mariner_guard {}
delete table inet mariner_guard
table inet mariner_guard {
    chain forward {
        type filter hook forward priority filter - 20; policy accept;
        # Hotspot traffic may only leave through the VPN app's tunnel.
        iifname "$NS_IF" oifname != { $TUN } counter drop comment "no tunnel, no traffic"
    }
    chain output {
        type filter hook output priority filter - 20; policy accept;
        # Mariner's DNS forwarder (user mariner-dns) may only use the tunnel, apart
        # from its answers back to the host end of the veth.
        meta skuid "mariner-dns" ip daddr != $NET oifname != { $TUN, "lo" } counter drop comment "dns via tunnel only"
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        iifname "$NS_IF" oifname { $TUN } masquerade
    }
}
EOF
    ;;
down)
    ip link del "$HOST_IF" 2>/dev/null || true
    ip netns del "$NS" 2>/dev/null || true
    ;;
*)
    echo "usage: $0 evpn|warp up|down" >&2
    exit 1
    ;;
esac
