[Unit]
Description=Mariner: hotspot DNS via ExpressVPN's DNS (inside the evpn sandbox)
PartOf=mariner-vpn-expressvpn.target
Requires=mariner-evpn-netns.service
After=mariner-evpn-netns.service expressvpn-service.service

[Service]
# Its own fixed user: the sandbox's guard table only lets "mariner-dns" send
# through the tunnel, so DNS can't leak if ExpressVPN disconnects. Not the
# web panel's user: this parses untrusted DNS packets and must not be able to
# read /etc/mariner/portal.json (session signing key).
User=mariner-dns
NetworkNamespacePath=/run/netns/evpn
Environment=MARINER_DNS_ADDR=10.200.0.2 MARINER_DNS_UPSTREAM=resolv MARINER_DNS_RESOLV=/etc/netns/evpn/resolv.conf
ExecStart=/usr/bin/python3 /usr/local/lib/mariner/bin/mariner-dns
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
