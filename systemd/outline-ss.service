[Unit]
Description=Outline client: sslocal, or mariner-ss for prefix keys (SOCKS5 on 127.0.0.1:9909)
PartOf=mariner-vpn-outline.target
After=network-online.target

[Service]
# Config with the access key is root-only; systemd hands a copy to this
# unprivileged dynamic user.
DynamicUser=yes
LoadCredential=outline.json:/etc/mariner/outline.json
ExecStart=/usr/local/lib/mariner/bin/outline-client ${CREDENTIALS_DIRECTORY}/outline.json
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
