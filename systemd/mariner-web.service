[Unit]
Description=Mariner web portal (http://10.42.0.1, hotspot only)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
User=mariner
Group=mariner
# Port 80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=/usr/local/lib/mariner/web
# Binds the hotspot address only; until uap0 has it, start fails and retries.
ExecStart=/usr/local/lib/mariner/venv/bin/uvicorn app:app --host 10.42.0.1 --port 80 \
    --no-server-header --log-level warning
Restart=always
RestartSec=3
# Privileged actions go through `sudo mariner-ctl`, so the usual sandboxing
# (NoNewPrivileges, ProtectSystem, CapabilityBoundingSet) can't be used: it
# would also apply to mariner-ctl. Keep what doesn't interfere.
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
