[Unit]
Description=Geph5 client (SOCKS5 on 127.0.0.1:9909)
PartOf=mariner-vpn-geph.target
After=network-online.target

[Service]
# Config with credentials is root-only; systemd hands a copy to this
# unprivileged dynamic user.
DynamicUser=yes
LoadCredential=geph.yaml:/etc/mariner/geph.yaml
CacheDirectory=geph5
# geph5 logs at debug level by default: far too chatty for the journal.
Environment=RUST_LOG=info NO_COLOR=1
ExecStart=/usr/local/bin/geph5-client --config ${CREDENTIALS_DIRECTORY}/geph.yaml
Restart=always
RestartSec=15
# IPv4 only. Geph prefers IPv6 bridges when the Pi has IPv6, and those routes
# measured ~1 Mbit/s against ~80 Mbit/s over IPv4 bridges on the same network.
# (The hotspot is IPv4-only anyway; Geph's own IPv6 is refused, nothing else.)
IPAddressDeny=::/0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
